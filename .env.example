# ===================================
# PORTFOLIO CONFIGURATION
# ===================================
# Copy this file to .env and fill in your values

# ===================================
# AUTHENTICATION (NextAuth.js)
# ===================================
# URL where your app is hosted (change for production)
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_secret_key_here

# ===================================
# ADMIN ACCESS
# ===================================
ADMIN_USER=admin
ADMIN_PASSWORD=your_secure_password_here

# ===================================
# SITE CONFIGURATION (Optional)
# ===================================
# Used for SEO, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ===================================
# EMAIL NOTIFICATIONS (Outlook)
# ===================================
# For sending email notifications when contact form is submitted
# Use your Outlook email and app password
OUTLOOK_EMAIL=your-email@outlook.com
OUTLOOK_PASSWORD=your-app-password

